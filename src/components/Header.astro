---
import HeaderLink from "./HeaderLink.astro";
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  DropdownSubmenu,
} from "astro-navbar";
---

<header class="gap-5 p-5 border-b-2 lg:flex bg-sky-200 border-slate-500">
  <Astronav>
    <div class="flex justify-between w-full xl">
      <a href="https://suzzastitches.com" class="brand-font">Suzza Stitches</a>
      <div class="block lg:hidden">
        <MenuIcon class="text-gray-800 w-15 h-15" />
      </div>
    </div>
    <MenuItems class="hidden lg:flex">
      <ul class="flex flex-col lg:flex-row lg:gap-4 med">
        <li class="list-none"><HeaderLink href="/">Home</HeaderLink></li>
        <li class="list-none"><HeaderLink href="/about">About</HeaderLink></li>
        <li class="list-none"><HeaderLink href="/blog">Blog</HeaderLink></li>
        <li class="list-none">
          <HeaderLink href="/current-projects">Projects</HeaderLink>
        </li>
        <li class="list-none">
          <HeaderLink href="/watching">Watchlist</HeaderLink>
        </li> 
        <li class="list-none">
          <HeaderLink href="/subscribe">Subscribe</HeaderLink>
        </li>
      </ul>
    </MenuItems>
  </Astronav>
</header>
