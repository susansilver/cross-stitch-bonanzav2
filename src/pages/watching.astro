---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LinkPreview } from "astro-embed";
---

<html lang="en">
  <head>
    <BaseHead
      title="Currently Watching"
      description="My favorite channels and people on Flosstube"
    />
  </head>
  <body>
    <Header />

    <main>
      <div
        class="flex flex-col items-center justify-center article-header bg-hero p-25 text-black-900"
      >
        <h1>Who I'm Watching</h1>
      </div>
      <div class="grid min-h-screen grid-cols-12 gap-4">
        <div class="col-span-2 bg-gradient"></div>
        <div class="col-span-10 text-black-900 lar padding-y-xxl">
          <section class="flex flex-col justify-center p-5">
            <p>
              This is a list of my favorite Flosstubers! If you haven't, check
              them out.
            </p>

            <h2 id="sunshine-stitchers">Sunshine Stitchers</h2>
            <LinkPreview id="https://www.youtube.com/@SunshineStitchers" />
            <h2 id="catkin">Catkin and Lillie</h2>

            <p>
              Kat also has a Patreon where you can chat with other cross
              stichers! I am am member and we are an international group i.e
              their are a few Americans there.
            </p>

            <p>
              <a href="https://www.patreon.com/catkinandlillie" target="_blank"
                >Catkin and Lillie Patreon</a
              >
            </p>

      
            <LinkPreview id="https://www.youtube.com/@catkinandlillie" />
            <h2 id="adelaide">Adelaide Stitches</h2>
            <LinkPreview id="https://www.youtube.com/@adelaidestitches" />
            <h2 id="cinema">cin3maticstitches</h2>
            <LinkPreview id="https://www.youtube.com/@cin3maticstitches" />
            <h2 id="enfys">Enfys</h2>
            <LinkPreview id="https://www.youtube.com/@sleepygoblincrafts" />
            <h2 id="helen">Helen D.</h2>
            <LinkPreview id="https://www.youtube.com/@helend.flosstube" />
            <h2 id="charlie">Stitching with Charlie</h2>
            <LinkPreview id="https://www.youtube.com/@stitchingwithcharlie" />
            <h2 id="stuart">Stuarts in Stitches</h2>
            <LinkPreview id="https://www.youtube.com/@stuartsinstitches" />
              <h2 id="runner">The Runner Stitcher</h2>
            <LinkPreview id="https://www.youtube.com/@therunnerstitcher" />
             <h2 id="614">The 614 Stitcher</h2>
            <LinkPreview id="https://www.youtube.com/@the614stitcher" />
             <h2 id="sundries">Stitches and Sundries</h2>
            <LinkPreview id="https://www.youtube.com/@stitchesandsundries" />
             <h2 id="strings">Stitch Strings and Other Things</h2>
            <LinkPreview id="https://www.youtube.com/@sticksstringsandotherthings" />
             <h2 id="snail">Slow Snail Stitching</h2>
            <LinkPreview id="https://www.youtube.com/@slowsnailstitching" />
            <h2 id="kissa">MKissaCreations</h2>
            <LinkPreview id="https://www.youtube.com/@MKissaCreations" />
        <h2 id="emily">Craftie Emily</h2>
            <LinkPreview id="https://www.youtube.com/@craftieemily323" />
            <h2 id="colourfully">ColourfullyCrossStitched</h2>
            <LinkPreview id="https://www.youtube.com/@ColourfullyCrossStitched" />
             <h2 id="becca">Becca_is_Stitching</h2>
            <LinkPreview id="https://www.youtube.com/@Becca_Is_Stitching" />
          </section>
        </div>
      </div>
    </main>
    <footer>
      <Footer />
    </footer>
  </body>
</html>
